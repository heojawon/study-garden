rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /subjects/{subjectId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['id', 'name', 'color'])
          && request.resource.data.keys().hasAll(['id', 'name', 'color'])
          && request.resource.data.id == subjectId
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 60
          && request.resource.data.color is string
          && request.resource.data.color.matches('^#[0-9A-Fa-f]{6}$');
        allow delete: if isOwner(uid);
      }

      match /sessions/{sessionId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.keys().hasOnly([
            'id', 'subjectId', 'startedAt', 'endedAt', 'focusSeconds', 'mode', 'completed'
          ])
          && request.resource.data.keys().hasAll([
            'id', 'subjectId', 'startedAt', 'endedAt', 'focusSeconds', 'mode', 'completed'
          ])
          && request.resource.data.id == sessionId
          && request.resource.data.subjectId is string
          && request.resource.data.subjectId.size() > 0
          && request.resource.data.startedAt is timestamp
          && request.resource.data.endedAt is timestamp
          && request.resource.data.startedAt <= request.resource.data.endedAt
          && request.resource.data.focusSeconds is int
          && request.resource.data.focusSeconds >= 0
          && request.resource.data.focusSeconds <= 172800
          && request.resource.data.mode == 'free'
          && request.resource.data.completed is bool;
        allow delete: if isOwner(uid);
      }

      match /{otherCollection}/{documentId} {
        allow read, write: if isOwner(uid)
          && otherCollection in ['goals', 'days'];
      }

      match /{document=**} {
        allow read, write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
